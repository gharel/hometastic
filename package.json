{
  "name": "nid",
  "version": "0.1.0",
  "private": true,
  "description": "Nid : l’application du foyer (courses, tâches, fiches, projets)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "apercu": "vite preview --port 4183 --strictPort",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run types && npm run test",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "dexie": "^4.4.7",
    "firebase": "^13.4.0",
    "preact": "^11.2.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.0.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.3.0",
    "firebase-admin": "^14.5.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-build": "^7.4.1"
  }
}
