rules_version = '2';

// Règles d’accès de Hometastic (ADR 0002) : un membre ne lit et n’écrit que dans son foyer.
// Chaque téléphone a un compte anonyme ; il devient membre en créant le foyer ou avec le lien
// d’invitation (secret du foyer). À coller dans la console Firebase, Firestore, onglet Règles.
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }

    function membre(foyerId) {
      return connecte()
        && request.auth.uid in get(/databases/$(database)/documents/foyers/$(foyerId)).data.uids;
    }

    match /foyers/{foyerId} {
      allow read: if connecte() && request.auth.uid in resource.data.uids;

      // Création : le téléphone qui crée le foyer en est le seul membre, avec un secret d’invitation.
      allow create: if connecte()
        && request.resource.data.uids == [request.auth.uid]
        && request.resource.data.invitation is string
        && request.resource.data.invitation.size() >= 22
        && request.resource.data.preuves == {};

      // Un membre peut tout modifier sauf la liste des membres, qui ne fait que grandir par invitation.
      allow update: if connecte()
        && request.auth.uid in resource.data.uids
        && request.resource.data.uids.hasAll(resource.data.uids);

      // Rejoindre : on ne s’ajoute soi-même qu’en présentant le secret d’invitation du foyer.
      allow update: if connecte()
        && !(request.auth.uid in resource.data.uids)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uids', 'preuves'])
        && request.resource.data.uids == resource.data.uids.concat([request.auth.uid])
        && request.resource.data.uids.size() <= 8
        && request.resource.data.preuves.diff(resource.data.preuves).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.preuves[request.auth.uid] == resource.data.invitation;

      allow delete: if false;

      // Listes, articles, tâches, fiches, appareils… : réservés aux membres du foyer.
      match /{table}/{document} {
        allow read, write: if membre(foyerId);
      }
    }
  }
}
